<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MAC_UI.ViewModels"
             xmlns:term="using:Iciclecreek.Terminal"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             x:Class="MAC_UI.Views.TerminalView"
             x:DataType="vm:TerminalViewModel"
             Background="#1E1E1E">

    <Grid RowDefinitions="30,*" Background="#1E1E1E">
        <Border Grid.Row="0" Background="#252526" BorderBrush="#2D2D30"
                BorderThickness="0,0,0,1" Padding="8,2">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              Background="#1E1E1E" BorderBrush="#3E3E42" Foreground="#CCCCCC"
                              FontSize="11" Height="24" Padding="8,2" CornerRadius="3">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShellProfile">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding WorkingDirectory}" Foreground="#888888" FontSize="11"
                               VerticalAlignment="Center" MaxWidth="520"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Command="{Binding RestartCommand}"
                        Background="Transparent" BorderThickness="0" Padding="6,4"
                        VerticalAlignment="Center" ToolTip.Tip="Reiniciar terminal">
                    <fluent:SymbolIcon Symbol="ArrowClockwise" Foreground="#888888" FontSize="12"/>
                </Button>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" x:Name="TerminalContainer" Margin="4,2" Background="#1E1E1E"/>
    </Grid>
</UserControl>