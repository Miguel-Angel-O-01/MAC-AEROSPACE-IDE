<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MAC_UI.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             x:Class="MAC_UI.Views.OutputView"
             x:DataType="vm:OutputViewModel"
             Background="#1E1E1E">

    <Grid RowDefinitions="32,*" Background="#1E1E1E">
        <!-- Fila 0: Barra superior de la consola con padding y altura suficiente -->
        <Border Grid.Row="0" 
                Background="#252526" 
                BorderBrush="#2D2D30" 
                BorderThickness="0,0,0,1" 
                Padding="8,3">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Mostrar salida de:" 
                               Foreground="#999999" 
                               FontSize="11" 
                               VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding OutputChannels}" 
                              SelectedItem="{Binding SelectedChannel}"
                              Background="#1E1E1E"
                              BorderBrush="#3E3E42"
                              Foreground="#CCCCCC"
                              FontSize="11" 
                              Height="24" 
                              Padding="8,2"
                              CornerRadius="3"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" 
                        Command="{Binding ClearOutputCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="6,4" 
                        VerticalAlignment="Center"
                        ToolTip.Tip="Borrar salida">
                    <fluent:SymbolIcon Symbol="Dismiss" Foreground="#888888" FontSize="11"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- Fila 1: Área de texto de salida con margen superior para no chocar -->
        <TextBox Grid.Row="1" 
                 Text="{Binding CurrentChannelText}" 
                 IsReadOnly="True"
                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                 FontSize="12"
                 Foreground="#CCCCCC"
                 Background="#1E1E1E"
                 BorderThickness="0"
                 Padding="8,6"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>