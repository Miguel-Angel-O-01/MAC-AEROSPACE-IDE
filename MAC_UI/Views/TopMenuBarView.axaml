<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MAC_UI.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             x:Class="MAC_UI.Views.TopMenuBarView"
             x:DataType="vm:TopMenuBarViewModel"
             Background="#252526">

    <Border Background="#252526" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="4,2">
        <DockPanel LastChildFill="False">
            
            <!-- 1. Menús Principales Desplegables -->
            <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center">
                <Menu.Styles>
                    <Style Selector="MenuItem">
                        <Setter Property="Foreground" Value="#D4D4D4"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Padding" Value="7,4"/>
                    </Style>
                    <Style Selector="MenuItem:pointerover">
                        <Setter Property="Background" Value="#3E3E42"/>
                    </Style>
                </Menu.Styles>

                <MenuItem Header="_Archivo">
                    <MenuItem Header="Nuevo">
                        <MenuItem Header="Proyecto / Solución..."/>
                        <MenuItem Header="Archivo..."/>
                    </MenuItem>
                    <MenuItem Header="Abrir">
                        <MenuItem Header="Proyecto / Solución..." InputGesture="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <MenuItem Header="Archivo..." InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" CommandParameter="{Binding $parent[Window]}"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Guardar" InputGesture="Ctrl+S" Command="{Binding SaveFileCommand}" CommandParameter="{Binding $parent[Window]}"/>
                    <MenuItem Header="Guardar todo" InputGesture="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem Header="Cerrar Solución"/>
                    <MenuItem Header="Salir" InputGesture="Alt+F4"/>
                </MenuItem>

                <MenuItem Header="_Editar">
                    <MenuItem Header="Deshacer" InputGesture="Ctrl+Z"/>
                    <MenuItem Header="Rehacer" InputGesture="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Cortar" InputGesture="Ctrl+X"/>
                    <MenuItem Header="Copiar" InputGesture="Ctrl+C"/>
                    <MenuItem Header="Pegar" InputGesture="Ctrl+V"/>
                    <Separator/>
                    <MenuItem Header="Buscar y reemplazar">
                        <MenuItem Header="Búsqueda rápida" InputGesture="Ctrl+F"/>
                        <MenuItem Header="Reemplazo rápido" InputGesture="Ctrl+H"/>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="_Ver">
                    <MenuItem Header="Código" InputGesture="F7"/>
                    <MenuItem Header="Diseñador / Vista 3D" InputGesture="Shift+F7"/>
                    <Separator/>
                    <MenuItem Header="Explorador de soluciones" InputGesture="Ctrl+Alt+L" Command="{Binding ToggleExplorerCommand}"/>
                    <MenuItem Header="Panel de Propiedades" InputGesture="F4"/>
                    <MenuItem Header="Terminal integrada" InputGesture="Ctrl+OemTilde"/>
                </MenuItem>

                <MenuItem Header="_Git">
                    <MenuItem Header="Clonar repositorio..."/>
                    <MenuItem Header="Crear repositorio local..."/>
                    <MenuItem Header="Confirmar cambios (Commit)..."/>
                    <MenuItem Header="Publicar en GitHub..."/>
                </MenuItem>

                <MenuItem Header="_Proyecto">
                    <MenuItem Header="Agregar nuevo elemento..." InputGesture="Ctrl+Shift+A"/>
                    <MenuItem Header="Agregar clase..."/>
                    <MenuItem Header="Administrar paquetes NuGet..."/>
                </MenuItem>

                <MenuItem Header="_Compilar">
                    <MenuItem Header="Compilar solución" InputGesture="Ctrl+Shift+B"/>
                    <MenuItem Header="Recompilar solución"/>
                    <MenuItem Header="Limpiar solución"/>
                </MenuItem>

                <MenuItem Header="_Depurar">
                    <MenuItem Header="Iniciar depuración" InputGesture="F5"/>
                    <MenuItem Header="Iniciar sin depurar" InputGesture="Ctrl+F5"/>
                    <MenuItem Header="Detener depuración" InputGesture="Shift+F5"/>
                </MenuItem>

                <MenuItem Header="_Formato">
                    <MenuItem Header="Dar formato al documento" InputGesture="Alt+Shift+F"/>
                </MenuItem>

                <MenuItem Header="_Herramientas">
                    <MenuItem Header="LM Studio / Servidor de Inferencia"/>
                    <MenuItem Header="Protocolo de Contexto de Modelo (MCP)"/>
                    <MenuItem Header="Línea de comandos / Developer Prompt"/>
                </MenuItem>

                <MenuItem Header="_Extensiones">
                    <MenuItem Header="Administrar extensiones..."/>
                    <MenuItem Header="Servidores LSP Registrados"/>
                </MenuItem>

                <MenuItem Header="_Ventana">
                    <MenuItem Header="Dividir vista (Horizontal / Vertical)"/>
                    <MenuItem Header="Cerrar todas las pestañas"/>
                </MenuItem>

                <MenuItem Header="_Ayuda">
                    <MenuItem Header="Documentación MAC IDE"/>
                    <MenuItem Header="Acerca de MAC AEROESPACE Studio"/>
                </MenuItem>
            </Menu>

            <!-- 2. Split Button de Búsqueda y Selector de Proyecto -->
            <StackPanel DockPanel.Dock="Left" 
                        Orientation="Horizontal" 
                        Spacing="8" 
                        VerticalAlignment="Center" 
                        Margin="8,0,0,0">

                <!-- Split Button Búsqueda Universal -->
                <Border Background="#2D2D30" 
                        BorderBrush="#3E3E42" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Height="24">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding OpenSearchWindowCommand}"
                                CommandParameter="{Binding $parent[Window]}"
                                Background="Transparent" 
                                BorderThickness="0" 
                                CornerRadius="3,0,0,3" 
                                Padding="7,0,4,0" 
                                Height="22"
                                ToolTip.Tip="Buscar archivos, tipos y miembros (Ctrl+T)">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#3E3E42"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <fluent:SymbolIcon Symbol="Search" Foreground="#CCCCCC" FontSize="11"/>
                                <TextBlock Text="Buscar" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="14" Fill="#3E3E42"/>

                        <DropDownButton Background="Transparent" 
                                        BorderThickness="0" 
                                        CornerRadius="0,3,3,0" 
                                        Padding="4,0,4,0" 
                                        Height="22"
                                        VerticalAlignment="Center">
                            <DropDownButton.Styles>
                                <Style Selector="DropDownButton:pointerover">
                                    <Setter Property="Background" Value="#3E3E42"/>
                                </Style>
                                <Style Selector="MenuItem">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="#D4D4D4"/>
                                </Style>
                            </DropDownButton.Styles>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Búsqueda de código (Ctrl+T)" 
                                              Command="{Binding OpenSearchWindowCommand}" 
                                              CommandParameter="{Binding $parent[Window]}"/>
                                    <MenuItem Header="Búsqueda de funciones (Ctrl+Q)" 
                                              Command="{Binding OpenSearchWindowCommand}" 
                                              CommandParameter="{Binding $parent[Window]}"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Border>

                <!-- Píldora del Proyecto Actual CON ANCHO MÍNIMO Y TEXTO GARANTIZADO -->
                <Border Background="#252526" 
                        BorderBrush="#3E3E42" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Height="24" 
                        MinWidth="70"
                        Padding="8,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentWorkspaceName, FallbackValue='Sin espacio de trabajo', TargetNullValue='Sin espacio de trabajo'}" 
                               Foreground="#CCCCCC" 
                               FontWeight="SemiBold" 
                               FontSize="11" 
                               VerticalAlignment="Center"/>
                </Border>

            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>